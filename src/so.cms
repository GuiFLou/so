/* ================================================================
 * SO Simples — Processador MIPS-Lite
 *
 * Kernel monolitico em C-.
 * Compilar com: ./compilador --txt so.cms
 *
 * Convencoes:
 *   - Sem structs: arrays paralelos simulam tabelas
 *   - Sem strings: o menu escreve o LCD em 4091 (lcdshow/lcdack/lcdsel)
 *   - Retorno de erro: 0 - 1  (equivale a -1)
 * ================================================================ */

/* ----------------------------------------------------------------
 * Catalogo publicado a partir do setor 0.
 * A opcao 1 usa o ID e o primeiro LBA. O tamanho fica no disco.
 * ---------------------------------------------------------------- */

int cat_id[10];
int cat_sector[10];
int cat_count;

void init_catalog(void)
{
    int i;
    i = 0;
    while (i < 10) {
        cat_id[i] = 0;
        cat_sector[i] = 0;
        i = i + 1;
    }
    cat_count = 0;
}

/* IDs e o primeiro LBA de cada trio, lidos do setor 0. */
int load_catalog(void)
{
    int st;
    int pos;
    int base;
    int n;
    int sig;

    st = loadHD(0, 1280);
    if (st != 0) return 0 - 1;
    sig = 2473 * 8191;
    sig = sig + 4670;
    if (mem_read(1280) != sig) return 0 - 1;
    if (mem_read(1281) != 1) return 0 - 1;
    init_catalog();
    pos = 0;
    n = 0;
    while (pos < 10) {
        base = 1280 + 20 + (4 * pos);
        if (mem_read(base) != 0) {
            cat_id[n] = mem_read(base + 2);
            cat_sector[n] = 1 + (3 * pos);
            n = n + 1;
        }
        pos = pos + 1;
    }
    while (pos < 16) {
        base = 1280 + 20 + (4 * pos);
        if (mem_read(base) != 0) return 0 - 1;
        pos = pos + 1;
    }
    cat_count = n;
    return 0;
}

int find_program(int id)
{
    int i;
    i = 0;
    while (i < cat_count) {
        if (cat_id[i] == id) return i;
        i = i + 1;
    }
    return 0 - 1;
}

/* ================================================================
 * Menu no LCD
 * KEY[2] e KEY[3] andam. KEY[1] liga o ack. IN/OUT nao entram aqui:
 * eles usam o mesmo botao e a CPU parada nao caminha no menu.
 * A opcao 1 carrega a janela, a folha e salta com runat.
 * A opcao 2 escolhe N e cai em ERR.
 * ================================================================ */

int wait_choice(void)
{
    int a;

    a = 0;
    while (a == 0) {
        a = lcdack();
    }
    return lcdsel();
}

/* fresh=1 entra na lista e o hardware zera o indice. fresh=0 continua
 * no item atual e so apaga o ack, para o proximo Enter valer. */
int choose_program(int fresh)
{
    int shown;
    int s;
    int a;
    int id;
    int ready;

    if (fresh == 1) {
        id = cat_id[0];
        lcdshow(6, id, 0);
        shown = 0;
    } else {
        s = lcdsel();
        id = cat_id[s];
        lcdshow(6, id, 0);
        shown = s;
    }

    a = 0;
    while (a == 0) {
        a = lcdack();
        if (a == 0) {
            s = lcdsel();
            if (s != shown) {
                ready = lcdack();
                if (ready == 0) {
                    id = cat_id[s];
                    lcdshow(6, id, 0);
                    shown = s;
                }
            }
        }
    }
    s = lcdsel();
    return cat_id[s];
}

void show_error(void)
{
    lcdshow(5, 0, 0);
    wait_choice();
}

int load_window(int sector)
{
    int st;

    st = loadHD(sector, 1536);
    if (st != 0) return st;
    st = loadHD(sector + 1, 1792);
    if (st != 0) return st;
    st = loadHD(sector + 2, 2048);
    return st;
}

int load_code(int sector)
{
    int st;

    st = loadROM(sector, 3072);
    if (st != 0) return st;
    st = loadROM(sector + 1, 3328);
    if (st != 0) return st;
    st = loadROM(sector + 2, 3584);
    return st;
}

void menu(void)
{
    int op;
    int n;
    int i;
    int fresh;
    int id;
    int idx;
    int st;

    lcdshow(2, 0, 0);
    wait_choice();

    while (1 == 1) {
        lcdshow(1, 0, 0);
        op = wait_choice();
        if (op == 0) {
            id = choose_program(1);
            idx = find_program(id);
            if (idx > 0 - 1) {
                st = load_window(31);
                if (st == 0) {
                    st = load_code(cat_sector[idx]);
                    if (st == 0) {
                        lcdshow(3, id, 0);
                        runat(3072);
                    } else {
                        show_error();
                    }
                } else {
                    show_error();
                }
            } else {
                show_error();
            }
        } else {
            if (op == 1) {
                lcdshow(7, 0, 0);
                n = wait_choice();
                n = n + 1;
                i = 0;
                fresh = 1;
                while (i < n) {
                    id = choose_program(fresh);
                    fresh = 0;
                    i = i + 1;
                }
                show_error();
            } else {
                if (op == 2) {
                    lcdshow(8, 0, 0);
                    wait_choice();
                }
            }
        }
    }
}

void main(void)
{
    int st;

    st = load_catalog();
    if (st != 0)
        show_error();
    menu();
}
